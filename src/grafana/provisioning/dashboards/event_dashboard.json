          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "piani = from(bucket: \"bike_monitoring\")\r\n  |> range(start: -1d)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"plan_bikes_recharging\")\r\n  |> last() \r\n  |> pivot(rowKey:[\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\r\n  |> map(fn: (r) => ({\r\n    r with \r\n    info: if exists r.bike_id and exists r.station and exists r.slot then \r\n      \"Put bike \" + string(v:r.bike_id) + \r\n      \" in charge at Station \" + string(v:r.station) + \r\n      \" at slot \" + string(v:r.slot)\r\n      else \"\"\r\n  }))\r\n  |> filter(fn: (r) => r.info != \"\")\r\n  |> group()\r\n  |> keep(columns: [\"bike_id\", \"info\", \"_time\"])\r\n\r\nallarmi = from(bucket: \"bike_monitoring\")\r\n  |> range(start: -1d)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"bike_analysis\")\r\n  |> last()\r\n  |> pivot(rowKey:[\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\r\n  |> filter(fn: (r) => r.event == \"OUT_OF_RANGE\")\r\n  |> map(fn: (r) => ({\r\n    bike_id: string(v: r.bike_id),\r\n    info: \"Bike \" + string(v:r.bike_id) + \" is out of range!\"\r\n  }))\r\n  |> group()\r\n  |> keep(columns: [\"bike_id\", \"info\", \"_time\"])\r\n\r\nunion(tables: [piani, allarmi])\r\n  |> group()\r\n  |> keep(columns: [\"bike_id\", \"info\", \"_time\"])",
          "refId": "A"
        }
